
{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "rootDir": "./",
    "outDir": "./build",
    
    // 💡 Switching to NodeNext for future-proofing
    "module": "NodeNext", 
    "moduleResolution": "NodeNext", // Consistency is key!
    
    "baseUrl": ".",
    "paths": {
      "@ioc:Adonis/*": ["../node_modules/@adonisjs/*/build/adonis-ioc.d.ts"],
      
      "@ioc:Adonis/Addons/Auth": ["../node_modules/@adonisjs/auth/types"], 
      
      "App/*": ["./app/*"],
      "Config/*": ["./config/*"],
      "Database/*": ["./database/*"]
    }
  },
  "include": ["**/*.ts"]
}
